+        # in this corpus, so q01 == q99 and quantile normalisation divides the
+        # rotation dims by ~0.  Restore their value explicitly.
+        return dataclasses.replace(
+            self.create_base_config(assets_dirs, model_config),
+            repack_transforms=repack_transform,
