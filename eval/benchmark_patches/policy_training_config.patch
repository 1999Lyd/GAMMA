+class EventBankReader:
+    """Serves the gate-C event/summary token bank ("event_bank" representation).
+
+    The bank npz contains, PER LEROBOT EPISODE INDEX <ep>:
+        tok_<ep>       [N, d_bank] float16   event/summary tokens
+        tok_from_<ep>  [N]         int64     first step the token is visible from
+        tok_until_<ep> [N]         int64     step the token expires at (-1 = never,
+                                             i.e. an accumulated EVENT token;
+                                             >= 0 = a windowed SUMMARY token)
+        len_<ep>       ()          int       episode length in steps
+
+    Visibility rule at (ep, t):  from <= t  and  (until < 0 or t < until).
+    Token type: until >= 0  (True = summary).
+
+    epis_idx MAPPING: the preprocessed dataset's epis_idx was verified to be
+    IDENTICAL to the lerobot episode index (all 1600 episode lengths match
+    between meta/episodes.jsonl, the bank's len_<ep>, and the preprocessed
+    features; prompts also match). See jax_port_plan.md "PORT LOG".
+
+    The bank is loaded ONCE. With preload=True (default) the whole npz is read
+    into RAM in the parent process before dataloader workers fork, so the pages
+    are shared copy-on-write. Set MME_EVENT_BANK_PRELOAD=0 for a lazy per-worker
+    zip-backed reader (LRU over per-episode token arrays) if RAM is tight.
+    """
+
+    def __init__(self, bank_path: str, budget: int, d_bank: int, preload: bool = True):
+        self.bank_path = bank_path
+        self.budget = int(budget)
+        self.d_bank = int(d_bank)
+        self.preload = preload
+        npz = np.load(bank_path, mmap_mode=None)
+        self.episodes = sorted(
+            int(k[len("len_"):]) for k in npz.files if k.startswith("len_")
+        )
+        # visibility metadata is small; always resident
+        self._from = {ep: npz[f"tok_from_{ep}"].astype(np.int32) for ep in self.episodes}
+        self._until = {ep: npz[f"tok_until_{ep}"].astype(np.int32) for ep in self.episodes}
+        self._len = {ep: int(npz[f"len_{ep}"]) for ep in self.episodes}
+        if preload:
+            logger.info(f"[event_bank] preloading {len(self.episodes)} episodes from {bank_path} ...")
+            self._tok = {ep: npz[f"tok_{ep}"] for ep in self.episodes}  # fp16, ~26GB
+            logger.info("[event_bank] preload done")
+            self._npz = None
+        else:
+            self._tok = None
+            self._npz = None  # opened lazily per worker process (fork safety)
+            self._npz_pid = None
+            self._lru = {}
+            self._lru_max = 32
+        npz.close()
+
+    def _tokens(self, ep: int) -> np.ndarray:
+        if self.preload:
+            return self._tok[ep]
+        # lazy mode: (re)open the npz in this process if needed
+        pid = os.getpid()
+        if self._npz is None or self._npz_pid != pid:
+            self._npz = np.load(self.bank_path, mmap_mode=None)
+            self._npz_pid = pid
+            self._lru = {}
+        if ep not in self._lru:
+            if len(self._lru) >= self._lru_max:
+                self._lru.pop(next(iter(self._lru)))
+            self._lru[ep] = self._npz[f"tok_{ep}"]
+        return self._lru[ep]
+
+    def visible(self, epis_idx: int, step_idx: int):
+        """Tokens visible at (episode, step), zero-padded to `budget`.
+
