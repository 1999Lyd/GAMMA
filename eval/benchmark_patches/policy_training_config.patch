+class RMBenchDataConfig(DataConfigFactory):
+    """RMBench (RoboTwin 2.0, ALOHA dual-arm).
+
+    Same plumbing as RoboMMEDataConfig with three RMBench-specific deltas:
+      * a THIRD camera (``observation/wrist_image_2`` -> right_wrist_0_rgb),
+        matching the official pi05_aloha_full_base observation spec.
+      * 16-d endpose state / 14-d joint actions instead of 8-d / 7-d.
+      * actions are ABSOLUTE joint targets (verified: consecutive |delta| mean
+        0.0032), so DeltaActions/AbsoluteActions ARE pushed -- the RoboMME
+        convention, NOT RMA's delta_action_mask=None. Getting this backwards
+        trains against wrong targets with a healthy-looking loss curve.
+    """
+
+    @override
+    def create(self, assets_dirs: pathlib.Path, model_config: _model.BaseModelConfig) -> DataConfig:
+        repack_transform = _transforms.Group(
+            inputs=[
+                _transforms.RepackTransform(
+                    {
+                        "observation/image": "image",
+                        "observation/wrist_image": "wrist_image",
+                        "observation/wrist_image_2": "wrist_image_2",
+                        "observation/state": "state",
+                        "actions": "actions",
+                        "prompt": "prompt",
+                        "static_image_emb": "static_image_emb",
+                        "static_pos_emb": "static_pos_emb",
+                        "static_state_emb": "static_state_emb",
+                        "static_mask": "static_mask",
+                        "recur_image_emb": "recur_image_emb",
+                        "recur_pos_emb": "recur_pos_emb",
+                        "recur_state_emb": "recur_state_emb",
+                        "recur_mask": "recur_mask",
+                        "simple_subgoal": "simple_subgoal",
+                        "grounded_subgoal": "grounded_subgoal",
+                    }
+                )
+            ]
+        )
+
+        data_transforms = _transforms.Group(
+            inputs=[RMBenchInputs(model_type=model_config.model_type)],
+            outputs=[RMBenchOutputs()],
+        )
+        # ALOHA layout is per-arm [6 joints | 1 gripper] x 2 = 14. Joints are
+        # deltas against state; BOTH grippers stay absolute -- hence
+        # (6, -1, 6, -1), not (14, -1). The latter is both a dim mismatch
+        # (length 15 vs 14-d actions) and semantically wrong: it would treat
+        # the right arm's first joint as a gripper and leave arm 1's gripper
+        # differenced against state.
+        delta_action_mask = _transforms.make_bool_mask(6, -1, 6, -1)
+        data_transforms = data_transforms.push(
+            inputs=[_transforms.DeltaActions(delta_action_mask)],
+            outputs=[_transforms.AbsoluteActions(delta_action_mask)],
+        )
+
+        model_transforms = ModelTransformFactory()(model_config)
+        return dataclasses.replace(
+            self.create_base_config(assets_dirs, model_config),
+            repack_transforms=repack_transform,
+            data_transforms=data_transforms,
+            model_transforms=model_transforms,
+        )
