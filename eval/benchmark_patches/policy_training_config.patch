+@dataclasses.dataclass(frozen=True)
+class LiberoOutputs(_transforms.DataTransformFn):
+    """LIBERO-MEM action width.  RoboMMEOutputs returns [:, :8] (7 joints +
+    gripper); LIBERO's action space is 7-d -- delta end-effector (xyz, rpy)
+    plus gripper -- and eval_pi05_libero_mem.py forwards whatever the server
+    returns straight to env.step, so the width must be exactly 7."""
+
+    def __call__(self, data: dict) -> dict:
+        return {"actions": np.asarray(data["actions"][:, :7])}
+
+
+@dataclasses.dataclass(frozen=True)
+class LiberoDataConfig(DataConfigFactory):
+    """RoboMMEDataConfig with LIBERO's action width and no delta transform.
+
+    delta_actions defaults FALSE and should stay there.  Measured on the
+    corpus: corr(a[t], state[t+1]-state[t]) = [.32 .73 .43 - - - -.30] versus
+    corr(a[t], state[t+1]) = [-.13 -.01 .02 - - - -.82], i.e. the recorded
+    action is ALREADY a delta end-effector command, in a different space from
+    the 8-d state and of a different width.  openpi's DeltaActions computes
+    action-minus-state, which mixes those units -- the same error that made
+    the MIKASA arms unusable.  Rotation channels 3-5 are identically zero in
+    this subset but are kept so the width matches the eval client.
+    """
+
+    delta_actions: bool = False
+
+    @override
+    def create(self, assets_dirs: pathlib.Path, model_config: _model.BaseModelConfig) -> DataConfig:
+        repack_transform = _transforms.Group(
+            inputs=[
+                _transforms.RepackTransform(
+                    {
+                        "observation/image": "image",
+                        "observation/wrist_image": "wrist_image",
+                        "observation/state": "state",
+                        "actions": "actions",
+                        "prompt": "prompt",
+                        "static_image_emb": "static_image_emb",
+                        "static_pos_emb": "static_pos_emb",
+                        "static_state_emb": "static_state_emb",
+                        "static_mask": "static_mask",
+                        "recur_image_emb": "recur_image_emb",
+                        "recur_pos_emb": "recur_pos_emb",
+                        "recur_state_emb": "recur_state_emb",
+                        "recur_mask": "recur_mask",
+                        "simple_subgoal": "simple_subgoal",
+                        "grounded_subgoal": "grounded_subgoal",
+                    }
+                )
+            ]
+        )
+        data_transforms = _transforms.Group(
+            inputs=[RoboMMEInputs(model_type=model_config.model_type)],
+            outputs=[LiberoOutputs()],
+        )
+        if self.delta_actions:
+            raise ValueError("delta_actions is wrong on LIBERO -- see the class docstring")
+        model_transforms = ModelTransformFactory()(model_config)
+        # create_base_config forces use_quantile_norm = (model_type != PI0),
