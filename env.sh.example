# GAMMA environment. Copy to env.sh, edit, then `source env.sh` before any script.
# Every script in this repo resolves machine-specific locations through these
# variables (they were absolute paths on the development machine).

# --- this repository -------------------------------------------------------
export GAMMA_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# scratch area for logs/intermediate files produced by chains and figure scripts
export GAMMA_WORK=${GAMMA_ROOT}/work
export GAMMA_LOGS=${GAMMA_WORK}/logs
# large data: corpus frames/detections/jsonl, LoRA adapters, serve traces
export GAMMA_DATA=${GAMMA_ROOT}/data

# --- benchmarks --------------------------------------------------------------
# RoboMME policy-learning repo (github.com/ai4ce/RoboMME policy_learning), with
# eval/benchmark_patches applied and eval/wam_subgoal_predictor.py copied into
# examples/robomme/
export ROBOMME_ROOT=/path/to/robomme_policy_learning_official
# RoboMemArena evaluation_benchmark checkout (only for the RMA port)
export RMA_BENCH_ROOT=/path/to/RoboMemArena/evaluation_benchmark

# --- python environments -----------------------------------------------------
# ms-swift environment (transformers with Qwen3.5 + SAM-3, peft, ms-swift): agents, SAM-3, server
export MSSWIFT_PY=/path/to/msswift_venv/bin/python
export MSSWIFT_BIN=$(dirname "${MSSWIFT_PY}")
# RoboMME eval-client environment (the benchmark's openpi client venv, with torch)
export CLIENT_PY=/path/to/robomme_client_venv/bin/python
# plain python3 with numpy/opencv/matplotlib for corpus generation and analysis
export GAMMA_PY=python3

# --- data roots and GPUs ---------------------------------------------------------
# large-data root (the development machine kept datasets and checkpoints on an archive volume)
export DATA_ROOT=${GAMMA_DATA}
# RoboMemArena: released demonstrations (HF dataset RoboMemArenaBenchmark/RoboMemArena) and the
# authors' released pi0.5 (huashuolei/PrediMem, folder vla_alltask), see rma/download_released_pi05.py
export RMA_DATA_ROOT=${DATA_ROOT}/rma_data/RoboMemArena
# lane launchers address GPUs by UUID (nvidia-smi -L); one variable per card
export GPU0=GPU-xxxxxxxx-...; export GPU1=GPU-xxxxxxxx-...; export GPU2=GPU-xxxxxxxx-...; export GPU3=GPU-xxxxxxxx-...
export GPU4=GPU-xxxxxxxx-...; export GPU5=GPU-xxxxxxxx-...; export GPU6=GPU-xxxxxxxx-...; export GPU7=GPU-xxxxxxxx-...

# --- caches ---------------------------------------------------------------------
export HF_HOME=${HF_HOME:-$HOME/.cache/huggingface}

mkdir -p "${GAMMA_WORK}" "${GAMMA_LOGS}" "${GAMMA_DATA}"
